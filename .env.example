# Скопируйте в .env и поправьте при необходимости
# cp .env.example .env

PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000
WIND_THRESHOLD_MS=10
PRECIP_THRESHOLD_MM=0.5
BODY_LIMIT=100kb
# Локально DB_HOST=localhost, в compose сервис app переопределяет DB_HOST=db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance
DB_USER=app
DB_PASSWORD=app
DB_NAME_TEST=maintenance_test
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
