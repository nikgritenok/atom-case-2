{
  "info": {
    "name": "Weather Digest — Open-Meteo",
    "description": "Коллекция для Кейса 1: геокодинг + прогноз. Переменные: baseUrl вынесены в переменные коллекции.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "geocodingBaseUrl", "value": "https://geocoding-api.open-meteo.com/v1/search" },
    { "key": "forecastBaseUrl", "value": "https://api.open-meteo.com/v1/forecast" },
    { "key": "city", "value": "Нижний Новгород" },
    { "key": "lat", "value": "56.32" },
    { "key": "lon", "value": "44.0" },
    { "key": "days", "value": "3" }
  ],
  "item": [
    {
      "name": "1. Geocoding — координаты по городу",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{geocodingBaseUrl}}?name={{city}}&count=1&language=ru&format=json",
          "host": ["{{geocodingBaseUrl}}"],
          "query": [
            { "key": "name", "value": "{{city}}" },
            { "key": "count", "value": "1" },
            { "key": "language", "value": "ru" },
            { "key": "format", "value": "json" }
          ]
        }
      },
      "response": [
        {
          "name": "Успех 200 — город найден",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "https://geocoding-api.open-meteo.com/v1/search?name=Нижний Новгород&count=1&language=ru&format=json",
              "host": ["https://geocoding-api.open-meteo.com/v1/search"],
              "query": [
                { "key": "name", "value": "Нижний Новгород" },
                { "key": "count", "value": "1" },
                { "key": "language", "value": "ru" },
                { "key": "format", "value": "json" }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "body": "{\"results\":[{\"id\":520555,\"name\":\"Нижний Новгород\",\"latitude\":56.32867,\"longitude\":44.00205,\"country\":\"Россия\",\"admin1\":\"Нижегородская Область\"}]}"
        },
        {
          "name": "Город не найден 200 — пустой results",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "https://geocoding-api.open-meteo.com/v1/search?name=XYZ123NoSuchCity&count=1&language=ru&format=json",
              "host": ["https://geocoding-api.open-meteo.com/v1/search"],
              "query": [
                { "key": "name", "value": "XYZ123NoSuchCity" },
                { "key": "count", "value": "1" },
                { "key": "language", "value": "ru" },
                { "key": "format", "value": "json" }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "body": "{\"generationtime_ms\":0.06496906}"
        }
      ]
    },
    {
      "name": "2. Forecast — прогноз по координатам",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{forecastBaseUrl}}?latitude={{lat}}&longitude={{lon}}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days={{days}}&timezone=auto",
          "host": ["{{forecastBaseUrl}}"],
          "query": [
            { "key": "latitude", "value": "{{lat}}" },
            { "key": "longitude", "value": "{{lon}}" },
            { "key": "daily", "value": "temperature_2m_max,temperature_2m_min,precipitation_sum" },
            { "key": "forecast_days", "value": "{{days}}" },
            { "key": "timezone", "value": "auto" }
          ]
        }
      },
      "response": [
        {
          "name": "Успех 200 — прогноз",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "https://api.open-meteo.com/v1/forecast?latitude=56.32&longitude=44.0&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days=1&timezone=auto",
              "host": ["https://api.open-meteo.com/v1/forecast"],
              "query": [
                { "key": "latitude", "value": "56.32" },
                { "key": "longitude", "value": "44.0" },
                { "key": "daily", "value": "temperature_2m_max,temperature_2m_min,precipitation_sum" },
                { "key": "forecast_days", "value": "1" },
                { "key": "timezone", "value": "auto" }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "body": "{\"latitude\":56.31,\"longitude\":44.0,\"timezone\":\"Europe/Moscow\",\"daily\":{\"time\":[\"2026-09-13\"],\"temperature_2m_max\":[16.2],\"temperature_2m_min\":[7.7],\"precipitation_sum\":[0.0]}}"
        },
        {
          "name": "Ошибка 400 — некорректные координаты",
          "originalRequest": {
            "method": "GET",
            "url": {
              "raw": "https://api.open-meteo.com/v1/forecast?latitude=9999&longitude=9999&forecast_days=1",
              "host": ["https://api.open-meteo.com/v1/forecast"],
              "query": [
                { "key": "latitude", "value": "9999" },
                { "key": "longitude", "value": "9999" },
                { "key": "forecast_days", "value": "1" }
              ]
            }
          },
          "status": "Bad Request",
          "code": 400,
          "body": "{\"error\":true,\"reason\":\"Latitude must be in range of -90 to 90°. Given: 9999.0.\"}"
        }
      ]
    }
  ]
}
