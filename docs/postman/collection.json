    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "technicianId", "value": "" },
    { "key": "sparePartId", "value": "" },
    { "key": "siteId", "value": "" }
  ],
  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "Проверка сервиса",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Код 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Есть статус ok', function () { var j = pm.response.json(); pm.expect(j.data.status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
