{
  "title": "Сервис заявок",
  "uid": "maintenance",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "panels": [
    {
      "id": 1,
      "title": "RPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Доля 4xx и 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(http_requests_total{code=~\"4..|5..\"}[5m])) / sum(rate(http_requests_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Latency p50/p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "legendFormat": "p95"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Ошибки 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum(rate(http_errors_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "title": "Доступность live",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "up{job=\"api\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "title": "Заявки по статусам",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "P44368ADAD746BC27"
      },
      "targets": [
        {
          "rawSql": "SELECT status, COUNT(*) AS total FROM maintenance_requests WHERE deleted_at IS NULL GROUP BY status",
          "datasource": {
            "type": "postgres",
            "uid": "P44368ADAD746BC27"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 7,
      "title": "Заявки по приоритетам",
      "type": "barchart",
      "datasource": {
        "type": "postgres",
        "uid": "P44368ADAD746BC27"
      },
      "targets": [
        {
          "rawSql": "SELECT priority, COUNT(*) AS total FROM maintenance_requests WHERE deleted_at IS NULL GROUP BY priority",
          "datasource": {
            "type": "postgres",
            "uid": "P44368ADAD746BC27"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 8,
      "title": "Среднее время закрытия, ч",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "P44368ADAD746BC27"
      },
      "targets": [
        {
          "rawSql": "SELECT AVG(EXTRACT(EPOCH FROM (updated_at - created_at)) / 3600) AS avg_hours FROM maintenance_requests WHERE status = 'done' AND deleted_at IS NULL",
          "datasource": {
            "type": "postgres",
            "uid": "P44368ADAD746BC27"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 9,
      "title": "Нагрузка на оборудование",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "P44368ADAD746BC27"
      },
      "targets": [
        {
          "rawSql": "SELECT e.name, COUNT(DISTINCT r.id) AS requests, COALESCE(SUM(a.hours), 0) AS hours FROM equipment e LEFT JOIN maintenance_requests r ON r.equipment_id = e.id AND r.deleted_at IS NULL LEFT JOIN request_assignees a ON a.request_id = r.id WHERE e.deleted_at IS NULL GROUP BY e.name ORDER BY requests DESC LIMIT 20",
          "datasource": {
            "type": "postgres",
            "uid": "P44368ADAD746BC27"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 10,
      "title": "Просроченные плановые",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "P44368ADAD746BC27"
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS overdue FROM maintenance_requests WHERE planned_at < NOW() AND status NOT IN ('done', 'rejected') AND deleted_at IS NULL",
          "datasource": {
            "type": "postgres",
            "uid": "P44368ADAD746BC27"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      }
    },
    {
      "id": 11,
      "title": "Запросы по маршрутам",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum by (route, code) (http_requests_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 12,
      "title": "Алерт: доля 5xx выше 5%",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "sum(rate(http_errors_total[5m])) / sum(rate(http_requests_total[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "alert": {
        "name": "Доля 5xx выше порога",
        "conditions": [
          {
            "evaluator": {
              "params": [
                0.05
              ],
              "type": "gt"
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "A",
                "5m",
                "now"
              ]
            },
            "reducer": {
              "params": [],
              "type": "avg"
            },
            "type": "query"
          }
        ],
        "executionErrorState": "alerting",
        "frequency": "1m",
        "noDataState": "no_data"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      }
    },
    {
      "id": 13,
      "title": "Трассировка запросов",
      "type": "text",
      "options": {
        "content": "Request ID: nginx генерирует $request_id, пробрасывает X-Request-Id в app, пишется в логи (requestId) и exemplars histogram. Найти: docker compose logs app | grep requestId.",
        "mode": "markdown"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 48
      }
    }
  ]
}